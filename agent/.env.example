# Copy to .env.local and fill in. Never commit the real file.

# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Sarvam (dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=priya          # female: priya, neha, ritu, kavya ... male: rahul, aditya, rohan ...
SARVAM_TTS_PACE=1.0
SARVAM_STT_LANGUAGE=unknown       # 'unknown' = auto-detect language per utterance

# Supabase project salon_agent (Settings -> API). Service role key: server only!
SUPABASE_URL=https://lqbwewoxovfreytutgvn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Name the website / SIP dispatch rule uses to call this agent
AGENT_NAME=headlocks-receptionist
